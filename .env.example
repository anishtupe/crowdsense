# Copy this file to .env and adjust as needed

DATABASE_URL=postgresql+psycopg2://crowdsense:crowdsense@localhost:5432/crowdsense
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Duplicate detection thresholds (core research tuning knobs)
DEDUP_TEXT_SIMILARITY_THRESHOLD=0.50
DEDUP_DISTANCE_METERS=500
DEDUP_TIME_WINDOW_MINUTES=120

# Clustering
CLUSTER_EPS_METERS=750
CLUSTER_EPS_MINUTES=180
CLUSTER_MIN_SAMPLES=2

# Vision (image evidence). false = fallback, no vision evidence.
# Thresholds are hand-set and untuned.
VISION_ENABLED=false
VISION_MODEL=clip-vit-b32-int8
# Download with: python scripts/fetch_vision_model.py  (relative to backend/)
VISION_MODEL_DIR=models/clip-vit-b32
VISION_MIN_LABEL_CONFIDENCE=0.5
VISION_CONFLICT_LOW=0.15
VISION_CONFLICT_HIGH=0.5
# Near-duplicate image threshold, in differing bits out of 64
VISION_PHASH_MAX_DISTANCE=8
# false = fuse without any image evidence (the "remove vision" ablation)
VISION_IN_FUSION=true

# Uploaded photos: max decoded size in bytes, longest side in px after re-encoding
MEDIA_MAX_BYTES=5000000
MEDIA_MAX_SIDE=1600

CORS_ORIGINS=http://localhost:5173
